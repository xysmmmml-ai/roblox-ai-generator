<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Roblox AI Script Generator</title>

  <script src="https://cdn.tailwindcss.com"></script>

  <link
    href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;1,400&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap"
    rel="stylesheet"
  >

  <style>
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background-color: #fcf9f5;
      background-image: radial-gradient(
        #e2d5c3 0.75px,
        transparent 0.75px
      );
      background-size: 16px 16px;
    }

    .serif-title {
      font-family: 'Playfair Display', serif;
    }

    textarea {
      resize: vertical;
    }

    #outputCode {
      min-height: 300px;
      max-height: 800px;
      overflow-y: auto;
    }
  </style>
</head>

<body class="text-stone-700 min-h-screen p-6">

  <div class="max-w-4xl mx-auto space-y-6">

    <!-- HEADER -->
    <header class="border-b border-rose-200/60 pb-5 text-center md:text-left">

      <h1 class="serif-title text-4xl font-semibold text-rose-900/80 tracking-wide">
        Roblox AI Script Generator
      </h1>

      <p class="text-stone-500 text-sm mt-1 italic">
        Craft elegant, clean Luau scripts for your Roblox Studio creations.
      </p>

    </header>


    <!-- GENERATOR CARD -->
    <div
      class="bg-white/70 backdrop-blur-md border border-rose-100 rounded-2xl p-6 shadow-sm space-y-5"
    >

      <!-- API KEY -->
      <div>

        <label
          class="block text-xs font-semibold uppercase tracking-wider text-stone-500 mb-2"
        >
          Groq API Key
        </label>

        <input
          id="apiKey"
          type="password"
          autocomplete="off"
          placeholder="Paste your gsk_... key here"
          class="w-full bg-stone-50/80 border border-rose-200/80 rounded-xl p-3 text-stone-800 placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-rose-300 text-sm transition-all"
        >

        <p class="text-xs text-stone-400 mt-2">
          Your key is used only for the request from this browser.
        </p>

      </div>


      <!-- PROMPT + PLATFORM -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">

        <!-- PROMPT -->
        <div class="md:col-span-2">

          <label
            class="block text-xs font-semibold uppercase tracking-wider text-stone-500 mb-2"
          >
            What script do you want to build?
          </label>

          <textarea
            id="prompt"
            class="w-full h-40 bg-stone-50/80 border border-rose-200/80 rounded-xl p-3 text-stone-800 placeholder-stone-400 focus:outline-none focus:ring-2 focus:ring-rose-300 text-sm transition-all"
            placeholder="Example: Create a Roblox restaurant cooking system with chopping, mixing, baking, seasoning, NPC customers, tips, reviews, furniture customization, and DataStore saving."
          ></textarea>

        </div>


        <!-- PLATFORM -->
        <div class="flex flex-col justify-between">

          <div>

            <label
              class="block text-xs font-semibold uppercase tracking-wider text-stone-500 mb-2"
            >
              Target Platform
            </label>

            <select
              id="engine"
              class="w-full bg-stone-50/80 border border-rose-200/80 rounded-xl p-3 text-stone-800 focus:outline-none focus:ring-2 focus:ring-rose-300 text-sm mb-4"
            >

              <option value="Roblox Studio (Luau)">
                Roblox (Luau)
              </option>

              <option value="Unity C#">
                Unity (C#)
              </option>

              <option value="Godot GDScript">
                Godot (GDScript)
              </option>

            </select>

          </div>


          <button
            id="generateBtn"
            onclick="generateCode()"
            class="w-full bg-rose-400 hover:bg-rose-500 disabled:bg-rose-200 text-white font-medium py-3 rounded-xl shadow-sm transition-all text-sm active:scale-[0.99]"
          >
            Generate Code
          </button>

        </div>

      </div>

    </div>


    <!-- OUTPUT -->
    <div
      id="outputContainer"
      class="hidden space-y-2"
    >

      <div class="flex justify-between items-center px-1">

        <label
          class="text-xs font-semibold uppercase tracking-wider text-stone-500"
        >
          Generated Code
        </label>

        <button
          onclick="copyCode()"
          class="text-xs bg-stone-200/80 hover:bg-stone-300/80 text-stone-700 px-3 py-1.5 rounded-lg transition-all font-medium"
        >
          Copy Code
        </button>

      </div>


      <pre
        id="outputCode"
        class="bg-stone-900 border border-stone-800 rounded-2xl p-5 text-xs font-mono text-emerald-300 overflow-x-auto whitespace-pre-wrap shadow-inner"
      ></pre>

    </div>

  </div>


  <!-- ========================================================= -->
  <!-- JAVASCRIPT -->
  <!-- ========================================================= -->

  <script>

    /*
     * ============================================================
     * CURRENT GROQ MODEL
     * ============================================================
     *
     * Groq retired:
     *
     * llama-3.1-8b-instant
     * llama-3.3-70b-versatile
     *
     * We use:
     *
     * openai/gpt-oss-20b
     *
     * ============================================================
     */

    const GROQ_API_URL =
      "https://api.groq.com/openai/v1/chat/completions";

    const GROQ_MODEL =
      "openai/gpt-oss-20b";


    /*
     * ============================================================
     * SEND REQUEST TO GROQ
     * ============================================================
     */

    async function queryGroq(
      apiKey,
      promptText,
      engineName
    ) {

      const response = await fetch(
        GROQ_API_URL,
        {
          method: "POST",

          headers: {
            "Authorization": "Bearer " + apiKey,
            "Content-Type": "application/json"
          },

          body: JSON.stringify({

            model: GROQ_MODEL,

            messages: [

              {
                role: "system",

                content:
                  `You are an expert game developer and Roblox Studio Luau developer.

Your job is to generate clean, working, production-quality code.

Target platform:
${engineName}

IMPORTANT RULES:

1. For Roblox, use valid Roblox Luau.
2. Never invent Roblox services or APIs.
3. Clearly state where every script belongs.
4. Use ModuleScripts for reusable systems.
5. Use ServerScriptService for server-authoritative systems.
6. Use ReplicatedStorage for shared modules and RemoteEvents.
7. Use StarterPlayerScripts for client systems.
8. Never expose API keys or secrets in generated Roblox code.
9. Validate RemoteEvents on the server.
10. Never trust the client with money, inventory, XP, purchases, or rewards.
11. Use DataStoreService correctly.
12. Use PathfindingService for NPC navigation where appropriate.
13. Use ProximityPrompt when appropriate.
14. Use TweenService for smooth interactions.
15. Do not use deprecated Roblox APIs.
16. If the request is too large for one script, split it into multiple scripts/modules.
17. Give complete code instead of pseudocode.
18. Explain the exact Roblox Studio location for each script.
19. If a 3D model, animation, sound, image, or other asset is required, create a placeholder system and explain what asset is required.
20. Make large systems modular and expandable.

When generating a large Roblox game system, organize the answer like this:

SCRIPT 1
Name:
Location:
Purpose:
Code:

SCRIPT 2
Name:
Location:
Purpose:
Code:

Continue as necessary.

Do not put an entire large game into one giant Script.`
              },

              {
                role: "user",
                content: promptText
              }

            ],

            temperature: 0.2,

            /*
             * GPT-OSS supports large outputs.
             * 8192 keeps browser responses manageable.
             */
            max_completion_tokens: 8192

          })
        }
      );

      return response;
    }


    /*
     * ============================================================
     * GENERATE CODE
     * ============================================================
     */

    async function generateCode() {

      const apiKey =
        document
          .getElementById("apiKey")
          .value
          .trim();


      const prompt =
        document
          .getElementById("prompt")
          .value
          .trim();


      const engine =
        document
          .getElementById("engine")
          .value;


      const button =
        document
          .getElementById("generateBtn");


      const container =
        document
          .getElementById("outputContainer");


      const output =
        document
          .getElementById("outputCode");


      /*
       * VALIDATION
       */

      if (!apiKey) {

        alert(
          "Please enter your Groq API key."
        );

        return;
      }


      if (!prompt) {

        alert(
          "Please enter what you want to build."
        );

        return;
      }


      /*
       * UI STATE
       */

      button.disabled = true;

      button.innerText =
        "Generating Script...";


      container.classList.remove(
        "hidden"
      );


      output.innerText =
        "Connecting to Groq...\n\n" +
        "Generating your code...";


      try {

        /*
         * SEND REQUEST
         */

        const response =
          await queryGroq(
            apiKey,
            prompt,
            engine
          );


        /*
         * GET RAW RESPONSE
         *
         * Reading text first gives us much
         * better error messages if Groq
         * doesn't return JSON.
         */

        const rawText =
          await response.text();


        let data;


        try {

          data =
            JSON.parse(rawText);

        } catch (jsonError) {

          output.innerText =
            "Groq returned an unexpected response.\n\n" +
            "HTTP Status: " +
            response.status +
            "\n\n" +
            rawText;

          return;
        }


        /*
         * HANDLE API ERRORS
         */

        if (!response.ok) {

          const errorMessage =
            data &&
            data.error &&
            data.error.message
              ? data.error.message
              : "Unknown Groq API error.";


          output.innerText =
            "Groq API Error\n\n" +

            "HTTP Status: " +
            response.status +

            "\n\n" +

            errorMessage;


          console.error(
            "Groq API Error:",
            data
          );


          return;
        }


        /*
         * GET GENERATED MESSAGE
         */

        if (
          data &&
          data.choices &&
          data.choices.length > 0 &&
          data.choices[0].message
        ) {

          const generatedCode =
            data.choices[0].message.content;


          if (generatedCode) {

            output.innerText =
              generatedCode;

          } else {

            output.innerText =
              "Groq returned an empty response.";
          }


          return;
        }


        /*
         * UNKNOWN RESPONSE
         */

        output.innerText =
          "Unexpected response from Groq.\n\n" +

          JSON.stringify(
            data,
            null,
            2
          );


      } catch (error) {

        /*
         * NETWORK ERROR
         */

        console.error(
          "Groq connection error:",
          error
        );


        output.innerText =
          "NETWORK ERROR\n\n" +

          "Unable to connect to Groq.\n\n" +

          "Possible causes:\n" +

          "• No internet connection\n" +

          "• Invalid API key\n" +

          "• Browser blocked the request\n" +

          "• Groq API unavailable\n" +

          "• CORS/network restrictions\n\n" +

          "Technical error:\n" +

          error.message;
      }


      /*
       * RESET BUTTON
       */

      finally {

        button.disabled = false;

        button.innerText =
          "Generate Code";
      }

    }


    /*
     * ============================================================
     * COPY GENERATED CODE
     * ============================================================
     */

    async function copyCode() {

      const codeText =
        document
          .getElementById("outputCode")
          .innerText;


      if (!codeText) {

        return;
      }


      try {

        await navigator.clipboard.writeText(
          codeText
        );


        alert(
          "Code copied to clipboard!"
        );


      } catch (error) {

        /*
         * Fallback for browsers that don't
         * allow navigator.clipboard.
         */

        const textArea =
          document.createElement(
            "textarea"
          );


        textArea.value =
          codeText;


        textArea.style.position =
          "fixed";


        textArea.style.left =
          "-9999px";


        document.body.appendChild(
          textArea
        );


        textArea.select();


        try {

          document.execCommand(
            "copy"
          );

          alert(
            "Code copied to clipboard!"
          );

        } catch (copyError) {

          alert(
            "Copy failed. Please select the generated code manually."
          );

        }


        document.body.removeChild(
          textArea
        );
      }

    }

  </script>

</body>
</html>
